{
  "name": "@sfops/api",
  "version": "1.0.0",
  "description": "SFOps API Service",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "db:migrate": "node-pg-migrate up",
    "db:rollback": "node-pg-migrate down",
    "db:seed": "ts-node scripts/seed.ts"
  },
  "dependencies": {
    "@apollo/server": "^4.9.5",
    "@opentelemetry/api": "^1.7.0",
    "@opentelemetry/instrumentation-express": "^0.34.0",
    "@opentelemetry/instrumentation-http": "^0.45.1",
    "@opentelemetry/sdk-node": "^0.45.1",
    "@sfops/salesforce-client": "*",
    "@sfops/shared": "*",
    "@sfops/vault-client": "*",
    "@temporalio/client": "^1.8.5",
    "bcrypt": "^5.1.1",
    "express": "^4.18.2",
    "graphql": "^16.8.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "node-vault": "^0.10.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "@node-saml/passport-saml": "^5.0.0",
    "pg": "^8.11.3",
    "pino": "^10.1.0",
    "prom-client": "^15.1.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/passport": "^1.0.16",
    "@types/passport-jwt": "^3.0.13",
    "@types/pg": "^8.10.9",
    "jest": "^29.7.0",
    "node-pg-migrate": "^6.2.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
