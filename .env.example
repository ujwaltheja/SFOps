# SFOps Environment Variables
# Copy this file to .env and fill in the values

# ====================
# Server Configuration
# ====================
NODE_ENV=development
PORT=3000
VERSION=1.0.0

# ====================
# Database
# ====================
DATABASE_URL=postgresql://sfops:sfops_dev_password@localhost:5432/sfops
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ====================
# Redis
# ====================
REDIS_URL=redis://localhost:6379

# ====================
# HashiCorp Vault
# ====================
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=root-token-dev
# For AppRole auth (production)
# VAULT_ROLE_ID=your-role-id
# VAULT_SECRET_ID=your-secret-id

# ====================
# Temporal
# ====================
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# ====================
# S3/Object Storage
# ====================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=sfops-snapshots
S3_REGION=us-east-1

# ====================
# JWT Authentication
# ====================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# ====================
# OAuth Providers
# ====================

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# SAML
SAML_ENTRY_POINT=https://your-idp.com/sso/saml
SAML_ISSUER=sfops
SAML_CERT=your-saml-certificate

# ====================
# Salesforce OAuth
# ====================
SALESFORCE_CLIENT_ID=your-salesforce-connected-app-client-id
SALESFORCE_CLIENT_SECRET=your-salesforce-connected-app-client-secret
SALESFORCE_CALLBACK_URL=http://localhost:3000/api/v1/auth/salesforce/callback

# ====================
# Observability
# ====================

# Jaeger (Distributed Tracing)
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Logging
LOG_LEVEL=info

# Metrics
ENABLE_METRICS=true
ENABLE_TRACING=true
ENABLE_AUDIT_LOG=true

# ====================
# Feature Flags
# ====================
ENABLE_SIGNUP=false
ENABLE_API_KEYS=true
ENABLE_SSO=true

# ====================
# Rate Limiting
# ====================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ====================
# Email/Notifications
# ====================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
FROM_EMAIL=noreply@sfops.io

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ====================
# Security
# ====================
CORS_ORIGIN=http://localhost:5173
SESSION_SECRET=your-session-secret

# ====================
# Development
# ====================
DEBUG=sfops:*
NODE_OPTIONS=--max-old-space-size=4096
