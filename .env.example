# SFOps Environment Configuration
# Copy this file to .env and update with your values

# =====================================
# Application Settings
# =====================================
NODE_ENV=development
APP_NAME=SFOps
APP_VERSION=1.0.0
PORT=4000

# =====================================
# Database Configuration
# =====================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sfops
DATABASE_USER=sfops_user
DATABASE_PASSWORD=your_secure_password_here
DATABASE_SSL=false
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20

# =====================================
# Redis Configuration
# =====================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# =====================================
# Authentication & Security
# =====================================
JWT_SECRET=your_jwt_secret_key_min_32_chars_required_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# API Keys for programmatic access
API_KEY_SALT=your_api_key_salt_here

# =====================================
# Salesforce Configuration
# =====================================
SF_API_VERSION=59.0
SF_LOGIN_URL=https://login.salesforce.com
SF_SANDBOX_LOGIN_URL=https://test.salesforce.com

# OAuth Connected App (for web flow)
SF_CLIENT_ID=your_salesforce_connected_app_client_id
SF_CLIENT_SECRET=your_salesforce_connected_app_client_secret
SF_CALLBACK_URL=http://localhost:4000/api/v1/oauth/callback

# =====================================
# HashiCorp Vault
# =====================================
VAULT_ENABLED=true
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=your_vault_root_token
VAULT_NAMESPACE=
VAULT_KV_PATH=secret/sfops

# =====================================
# Object Storage (S3/MinIO)
# =====================================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=sfops-artifacts
S3_REGION=us-east-1
S3_USE_SSL=false
S3_FORCE_PATH_STYLE=true

# =====================================
# Git Configuration
# =====================================
GIT_WORKSPACE_DIR=/tmp/sfops-workspaces
GIT_WEBHOOK_SECRET=your_webhook_secret_here

# GitHub OAuth (for repository access)
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# GitLab OAuth
GITLAB_CLIENT_ID=your_gitlab_oauth_app_client_id
GITLAB_CLIENT_SECRET=your_gitlab_oauth_app_client_secret

# =====================================
# Email Configuration (SMTP)
# =====================================
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=SFOps <noreply@sfops.io>

# =====================================
# Slack Integration
# =====================================
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# =====================================
# Logging
# =====================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_PATH=/var/log/sfops
LOG_MAX_FILES=10
LOG_MAX_SIZE=10m

# =====================================
# Monitoring & Observability
# =====================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

TRACING_ENABLED=false
JAEGER_ENDPOINT=http://localhost:14268/api/traces

SENTRY_ENABLED=false
SENTRY_DSN=your_sentry_dsn_here

# =====================================
# Job Queue Configuration
# =====================================
QUEUE_CONCURRENCY=5
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY=5000

# Deployment worker settings
DEPLOYMENT_TIMEOUT_MINUTES=120
VALIDATION_TIMEOUT_MINUTES=30
MAX_PARALLEL_VALIDATIONS=3

# =====================================
# Rate Limiting
# =====================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# =====================================
# CORS Configuration
# =====================================
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# =====================================
# Frontend Configuration
# =====================================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# =====================================
# Feature Flags
# =====================================
FEATURE_ROLLBACK_ENABLED=true
FEATURE_PARALLEL_DEPLOYMENTS=true
FEATURE_STATIC_ANALYSIS=false
FEATURE_AI_INSIGHTS=false

# =====================================
# Data Retention
# =====================================
ARTIFACT_RETENTION_DAYS=90
LOG_RETENTION_DAYS=180
AUDIT_LOG_RETENTION_DAYS=2555

# =====================================
# CLI Configuration
# =====================================
CLI_CONFIG_DIR=~/.sfops
CLI_DEFAULT_TIMEOUT=300000
